{
  "name": "gaspardnz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-static-seo-routes.mjs && node scripts/fix-static-seo-meta.mjs && node scripts/enrich-acquisition-seo.mjs && node scripts/enrich-core-seo.mjs",
    "test:seo": "node scripts/validate-seo.mjs",
    "test:seo-built": "node scripts/validate-built-seo-routes.mjs",
    "test:email-security": "node scripts/validate-email-api-security.mjs",
    "test:video-accessibility": "node scripts/validate-video-accessibility.mjs",
    "test:consent": "node scripts/validate-consent.mjs",
    "test:admin-auth": "node scripts/validate-admin-auth.mjs",
    "test:rbac": "node scripts/validate-rbac.mjs",
    "test:audit": "node scripts/validate-audit.mjs",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:bundle": "npm run build:app && vitest run --config vitest.bundle.config.js",
    "test:e2e": "node scripts/browser-checks/run-all.mjs",
    "test": "npm run test:unit && npm run test:seo && npm run test:email-security && npm run test:video-accessibility && npm run test:consent && npm run test:admin-auth && npm run test:rbac && npm run test:audit",
    "build:app": "BUILD_TARGET=capacitor vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build:app && npx cap sync",
    "cap:sync:ios": "npm run build:app && npx cap sync ios",
    "cap:sync:android": "npm run build:app && npx cap sync android",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "android:add": "npx cap add android",
    "android:build:debug": "cd android && ./gradlew assembleDebug",
    "android:bundle:release": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/push-notifications": "^8.0.4",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@supabase/supabase-js": "^2.57.4",
    "crypto-js": "^4.2.0",
    "framer-motion": "^11.0.0",
    "nodemailer": "^9.1.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-onesignal": "^3.5.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.63.0",
    "vite": "^8.0.14",
    "vitest": "^3.2.7"
  }
}
