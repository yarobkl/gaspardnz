# ============================================
# GASPARDNZ BACKEND CONFIGURATION (Vercel)
# ============================================
# Configure in Vercel Project Settings > Environment Variables.
# Never commit real secret values.

SITE_URL=https://gaspardnz.style
ALLOWED_ORIGINS=https://gaspardnz.style,https://www.gaspardnz.style

# ============================================
# SUPABASE SERVER
# ============================================
SUPABASE_URL=https://imvjudhhtcdmtyhfhksm.supabase.co
# Server-only. Never expose this as a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================
# GOOGLE ANALYTICS + SEARCH CONSOLE
# ============================================
# OAuth Web application credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Production callback must also be registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=https://gaspardnz.style/api/google/callback

# ============================================
# CALENDLY
# ============================================
# Server-only token for the GaspardNZ Calendly account.
# Used to import real scheduled events and invitees into CRM/bookings.
CALENDLY_PERSONAL_ACCESS_TOKEN=your-calendly-personal-access-token

# ============================================
# EMAIL CONFIGURATION (Backend - Vercel)
# ============================================
EMAIL_FROM=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
ALLOWED_EMAIL_RECIPIENTS=gaspardnz.contact@gmail.com,eliebakala@gmail.com

# ============================================
# OPTIONAL CHECKOUT
# ============================================
VITE_LOOKBOOK_STRIPE_URL=

# Alternative SMTP providers can be used by changing SMTP_HOST/SMTP_PORT
# and the relevant credentials. For delivery/open/click webhooks, prefer a
# transactional provider that exposes signed webhook events.
