# ============================================
# EMAIL CONFIGURATION (Backend - Vercel)
# ============================================
# À configurer dans Vercel Project Settings > Environment Variables

# Service d'email: Gmail SMTP
EMAIL_FROM=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SITE_URL=https://gaspardnz.style
ALLOWED_ORIGINS=https://gaspardnz.style,https://www.gaspardnz.style
ALLOWED_EMAIL_RECIPIENTS=gaspardnz.contact@gmail.com,eliebakala@gmail.com

# OU Service d'email: Mailgun
# EMAIL_FROM=noreply@yourdomain.com
# EMAIL_PASSWORD=your-mailgun-key
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false

# OU Service d'email: SendGrid
# EMAIL_FROM=noreply@yourdomain.com
# EMAIL_PASSWORD=your-sendgrid-api-key
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false

# ============================================
# NOTES GMAIL
# ============================================
# 1. Activer 2FA sur ton compte Google
# 2. Créer un "App Password" (mot de passe d'application)
# 3. Utiliser ce mot de passe pour EMAIL_PASSWORD
# 4. Lien: https://myaccount.google.com/apppasswords
