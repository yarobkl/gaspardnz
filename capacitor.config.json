{
  "appId": "com.gaspardnz.app",
  "appName": "GaspardNZ",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "scheme": "Gaspardnz",
    "backgroundColor": "#21160E"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#21160E",
      "iosSpinnerStyle": "small",
      "spinnerColor": "#8A5A2B",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#21160E"
    }
  }
}
