{
  "appId": "com.gaspardnz.app",
  "appName": "Gaspardnz",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "scheme": "Gaspardnz",
    "backgroundColor": "#1c1208"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#1c1208",
      "iosSpinnerStyle": "small",
      "spinnerColor": "#b8973e",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#1c1208"
    }
  }
}
